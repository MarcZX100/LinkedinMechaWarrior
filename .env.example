# LinkedIn URL used by the local assistant.
LINKEDIN_URL=https://www.linkedin.com/feed/

# Local persistent Chromium profile. This folder stores browser session data.
BROWSER_PROFILE_DIR=.browser-profile

# Diagnostic screenshots are written here when browser automation fails.
DEBUG_DIR=debug

# Keep false for a visible browser. Headless LinkedIn automation is brittle and harder to review.
HEADLESS=false

# Playwright timeout in milliseconds.
DEFAULT_TIMEOUT_MS=30000

# LinkedIn posts are commonly limited to 3000 characters.
MAX_POST_CHARS=3000

# Auto-publish remains blocked unless this is exactly true AND --publish is passed
# AND the interactive confirmation is typed as PUBLICAR.
ALLOW_AUTO_PUBLISH=false
